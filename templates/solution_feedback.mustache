{{!
    Canonical structured solution feedback.
}}
{{#hascontent}}
<section class="cp-solution-feedback mt-3" aria-label="{{#str}}generalfeedback, local_casospracticos{{/str}}">
    {{#isblocked}}
    <div class="alert alert-warning mb-3">{{#str}}feedbackblockednotice, local_casospracticos{{/str}}</div>
    {{/isblocked}}
    {{#hasreasoning}}
    <div class="cp-reasoning alert alert-info mb-3">
        <h5 class="alert-heading">{{#str}}reasoning, local_casospracticos{{/str}}</h5>
        {{{reasoning}}}
    </div>
    {{/hasreasoning}}
    {{#hasmodelanswer}}
    <div class="cp-model-answer card border-primary mb-3">
        <div class="card-header bg-primary text-white">
            <strong>{{#str}}modelanswer, local_casospracticos{{/str}}</strong>
        </div>
        <div class="card-body">{{{modelanswer}}}</div>
    </div>
    {{/hasmodelanswer}}
</section>
{{/hascontent}}
