{{!
    @template local_casospracticos/case_view

    Template for displaying a single practical case with questions.

    Context variables required for this template:
    * case - Case object with id, name, statusclass, statuslabel, questioncount, totalmarks, hasquestions
    * canedit - Boolean for edit capability (per-question action links)
    * showpractice - Boolean: show the practice/timed/my-attempts buttons (has questions and full access)
    * showquestions - Boolean: render the questions + summary (false for statement-only/preview users)
    * practiceurl, timedurl, myattemptsurl - URLs for the practice buttons
    * canexport, exporturl - Export button
    * canstats, statsurl - Statistics button
    * printable - Boolean: show the print button
    * newquestionurl, backurl - URLs
    * teachermenuhtml - Pre-rendered core action_menu (edit case / new question / insert into quiz), trusted HTML
    * attachmentshtml - Pre-rendered attachments block, trusted HTML (may be empty)
    * upgradectahtml - Pre-rendered upgrade CTA for statement-only users, trusted HTML (may be empty)
    * questions - Array of question objects, each with number, questiontext, qtypelabel, defaultmark,
                  answers[], solutionhtml (pre-rendered solution feedback + normativa), and per-question
                  action booleans/urls (canmoveup, canmovedown, moveupurl, movedownurl, editurl, deleteurl)

    Example context (json):
    {
        "case": {
            "id": 1,
            "name": "Caso sobre silencio administrativo",
            "statement": "<p>Enunciado largo...</p>",
            "statusclass": "bg-success",
            "statuslabel": "Publicado",
            "questioncount": 3,
            "totalmarks": 3.0,
            "hasquestions": true
        },
        "canedit": true,
        "showpractice": true,
        "showquestions": true,
        "practiceurl": "https://example.com/practice.php?id=1",
        "timedurl": "https://example.com/practice_timed.php?id=1",
        "myattemptsurl": "https://example.com/my_attempts.php?caseid=1",
        "canexport": false,
        "canstats": false,
        "printable": true,
        "newquestionurl": "https://example.com/question_edit.php?caseid=1",
        "backurl": "https://example.com/index.php?category=1",
        "teachermenuhtml": "",
        "attachmentshtml": "",
        "upgradectahtml": "",
        "questions": [
            {
                "id": 1,
                "number": 1,
                "questiontext": "¿Cuál es el plazo?",
                "qtypelabel": "Opción múltiple",
                "defaultmark": 1.0,
                "canedit": false,
                "answers": [
                    {"id": 1, "answer": "3 meses", "iscorrect": true, "showfraction": false, "fraction": 100},
                    {"id": 2, "answer": "6 meses", "iscorrect": false, "showfraction": false, "fraction": 0}
                ],
                "solutionhtml": ""
            }
        ]
    }
}}
<div class="local-casospracticos-case-view" data-caseid="{{case.id}}" role="article" aria-labelledby="case-title-{{case.id}}">
    {{! Case Header }}
    <div class="case-header mb-4 pb-3 border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h2 class="mb-2" id="case-title-{{case.id}}">{{{case.name}}}</h2>
                <span class="badge {{case.statusclass}}" role="status">{{case.statuslabel}}</span>
            </div>
            <div class="case-actions d-flex flex-wrap gap-2" role="group" aria-label="{{#str}}caseactions, local_casospracticos{{/str}}">
                {{#showpractice}}
                <a href="{{practiceurl}}" class="btn btn-primary">
                    {{#pix}}i/preview, core{{/pix}} {{#str}}practice, local_casospracticos{{/str}}
                </a>
                <a href="{{timedurl}}" class="btn btn-outline-secondary">
                    {{#pix}}i/scheduled, core{{/pix}} {{#str}}timedpractice, local_casospracticos{{/str}}
                </a>
                <a href="{{myattemptsurl}}" class="btn btn-outline-secondary">
                    {{#pix}}i/report, core{{/pix}} {{#str}}viewmyattempts, local_casospracticos{{/str}}
                </a>
                {{/showpractice}}
                {{#canexport}}
                <a href="{{exporturl}}" class="btn btn-outline-secondary">
                    {{#pix}}i/export, core{{/pix}} {{#str}}export, local_casospracticos{{/str}}
                </a>
                {{/canexport}}
                {{#canstats}}
                <a href="{{statsurl}}" class="btn btn-outline-secondary">
                    {{#pix}}i/stats, core{{/pix}} {{#str}}statistics, local_casospracticos{{/str}}
                </a>
                {{/canstats}}
                {{#printable}}
                <button type="button" class="btn btn-outline-secondary" onclick="window.print(); return false;">
                    {{#pix}}t/print, core{{/pix}} {{#str}}print, local_casospracticos{{/str}}
                </button>
                {{/printable}}
                {{{teachermenuhtml}}}
            </div>
        </div>
    </div>

    {{! Case Statement }}
    <div class="case-statement card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{{#str}}casestatement, local_casospracticos{{/str}}</h5>
        </div>
        <div class="card-body">
            {{{case.statement}}}
        </div>
    </div>

    {{! Attachments (pre-rendered in PHP; empty when the case has none) }}
    {{{attachmentshtml}}}

    {{#showquestions}}
    {{! Questions Section }}
    <section class="case-questions" aria-labelledby="questions-heading">
        <h4 class="mb-3" id="questions-heading">
            {{#str}}questions, local_casospracticos{{/str}}
            <span class="badge bg-secondary" aria-hidden="true">{{case.questioncount}}</span>
            <span class="visually-hidden">{{case.questioncount}} {{#str}}questions, local_casospracticos{{/str}}</span>
        </h4>

        {{^questions}}
        <div class="alert alert-info" role="status">
            {{#str}}noquestions, local_casospracticos{{/str}}
            {{#canedit}}
            <a href="{{newquestionurl}}" class="alert-link">{{#str}}newquestion, local_casospracticos{{/str}}</a>
            {{/canedit}}
        </div>
        {{/questions}}

        {{#questions}}
        <article class="question-item card mb-3" data-questionid="{{id}}" aria-labelledby="question-{{id}}-title">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div id="question-{{id}}-title">
                    <span class="badge bg-primary me-2" aria-label="{{#str}}questionnumber, local_casospracticos{{/str}} {{number}}">#{{number}}</span>
                    <span class="badge bg-info">{{qtypelabel}}</span>
                    <span class="badge bg-secondary ms-2">{{defaultmark}} {{#str}}points, grades{{/str}}</span>
                </div>
                {{#canedit}}
                <nav class="question-actions" role="toolbar" aria-label="{{#str}}questionactions, local_casospracticos{{/str}}">
                    {{#canmoveup}}
                    <a href="{{moveupurl}}" class="btn btn-sm btn-link" aria-label="{{#str}}moveup{{/str}} {{#str}}question{{/str}} {{number}}">
                        {{#pix}}t/up, core{{/pix}}
                        <span class="visually-hidden">{{#str}}moveup{{/str}}</span>
                    </a>
                    {{/canmoveup}}
                    {{#canmovedown}}
                    <a href="{{movedownurl}}" class="btn btn-sm btn-link" aria-label="{{#str}}movedown{{/str}} {{#str}}question{{/str}} {{number}}">
                        {{#pix}}t/down, core{{/pix}}
                        <span class="visually-hidden">{{#str}}movedown{{/str}}</span>
                    </a>
                    {{/canmovedown}}
                    <a href="{{editurl}}" class="btn btn-sm btn-link" aria-label="{{#str}}edit{{/str}} {{#str}}question{{/str}} {{number}}">
                        {{#pix}}t/edit, core{{/pix}}
                        <span class="visually-hidden">{{#str}}edit{{/str}}</span>
                    </a>
                    <a href="{{deleteurl}}" class="btn btn-sm btn-link text-danger" aria-label="{{#str}}delete{{/str}} {{#str}}question{{/str}} {{number}}">
                        {{#pix}}t/delete, core{{/pix}}
                        <span class="visually-hidden">{{#str}}delete{{/str}}</span>
                    </a>
                </nav>
                {{/canedit}}
            </div>
            <div class="card-body">
                <div class="question-text mb-3">
                    {{{questiontext}}}
                </div>

                {{#canviewanswers}}
                {{#hasanswers}}
                <ul class="list-group" role="list" aria-label="{{#str}}answers, local_casospracticos{{/str}}">
                    {{#answers}}
                    <li class="list-group-item {{#iscorrect}}list-group-item-success{{/iscorrect}}" aria-label="{{#iscorrect}}{{#str}}correctanswer, local_casospracticos{{/str}}{{/iscorrect}}{{^iscorrect}}{{#str}}incorrectanswer, local_casospracticos{{/str}}{{/iscorrect}}">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                {{#iscorrect}}
                                {{#pix}}i/valid, core{{/pix}}
                                <span class="visually-hidden">{{#str}}correct, local_casospracticos{{/str}}</span>
                                {{/iscorrect}}
                                {{^iscorrect}}
                                {{#pix}}i/invalid, core{{/pix}}
                                <span class="visually-hidden">{{#str}}incorrect, local_casospracticos{{/str}}</span>
                                {{/iscorrect}}
                                {{{answer}}}
                            </div>
                            {{#showfraction}}
                            <span class="badge bg-info" aria-label="{{fraction}} {{#str}}percentgrade, grades{{/str}}">{{fraction}}%</span>
                            {{/showfraction}}
                        </div>
                        {{#feedback}}
                        <div class="answer-feedback mt-2 ps-4 text-muted small" role="note">
                            <em>{{#pix}}i/info, core{{/pix}} {{{feedback}}}</em>
                        </div>
                        {{/feedback}}
                    </li>
                    {{/answers}}
                </ul>
                {{/hasanswers}}

                {{! Canonical solution feedback + normativa links, pre-rendered in PHP }}
                {{{solutionhtml}}}
                {{/canviewanswers}}
            </div>
        </article>
        {{/questions}}
    </section>

    {{! Summary }}
    <div class="case-summary card mt-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <strong>{{#str}}numquestions, local_casospracticos, {{case.questioncount}}{{/str}}</strong>
                </div>
                <div class="col-md-4">
                    <strong>{{#str}}defaultmark, local_casospracticos{{/str}}:</strong> {{case.totalmarks}}
                </div>
                <div class="col-md-4 text-end">
                    <a href="{{backurl}}" class="btn btn-outline-secondary">
                        {{#str}}backtocases, local_casospracticos{{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/showquestions}}

    {{^showquestions}}
    {{! Statement-only / preview users: upgrade CTA (empty for preview), never the questions }}
    {{{upgradectahtml}}}
    {{/showquestions}}
</div>
